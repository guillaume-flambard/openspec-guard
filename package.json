{
  "name": "spec-guard",
  "version": "0.1.0",
  "description": "Deterministically check which OpenSpec scenarios are covered by a Vitest or Jest test. Never runs the tests, never calls an LLM.",
  "keywords": [
    "openspec",
    "spec-driven",
    "traceability",
    "test-coverage",
    "vitest",
    "jest"
  ],
  "license": "MIT",
  "author": "Guillaume Flambard <g.flambard@gmail.com>",
  "publisher": "Memo Labs (entreprise individuelle, SIREN 924107469)",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@11.24.0",
  "bin": {
    "spec-guard": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.2",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guillaume-flambard/spec-guard.git"
  },
  "homepage": "https://github.com/guillaume-flambard/spec-guard#readme",
  "bugs": {
    "url": "https://github.com/guillaume-flambard/spec-guard/issues"
  }
}
